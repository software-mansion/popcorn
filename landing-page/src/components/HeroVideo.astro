---
import PlayIcon from "./PlayIcon.astro";
---

<div
  class="border-ink relative flex w-full items-center justify-center rounded-[2rem] border p-4 backdrop-blur-lg md:rounded-2xl md:p-0 lg:rounded-[2.5rem] lg:p-4"
>
  <div
    class="bg-ink flex aspect-video w-full items-center justify-center rounded-2xl lg:rounded-3xl"
  >
    <span
      class="bg-orange text-cream lg:bg-cream lg:text-orange lg:outline-orange flex items-center justify-center rounded-full p-5 md:p-7 lg:outline-2"
      aria-hidden="true"
    >
      <PlayIcon />
    </span>
  </div>
</div>
