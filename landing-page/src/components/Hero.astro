---
import Heading from "./Heading.astro";
import HeroVideo from "./HeroVideo.astro";
import InstallCommand from "./InstallCommand.astro";
import SoftwareMansionMark from "./SoftwareMansionMark.astro";
import StripedBackground from "./StripedBackground.astro";
---

<section class="bg-ink relative overflow-hidden">
  <StripedBackground scalloped />

  <div
    class="relative z-10 mx-auto flex w-full max-w-258 flex-col items-center gap-7 pt-24 pb-28 md:gap-10 md:pt-26 md:pb-34 lg:gap-28 lg:pt-44 lg:pb-44"
  >
    <div class="flex w-full flex-col items-center gap-10">
      <header
        class="flex w-full flex-col items-center gap-6 px-6 pt-8 md:gap-4 md:px-0 md:pt-11 lg:gap-3 lg:pt-0"
      >
        <div
          class="flex w-full flex-col items-center gap-3 md:max-w-192 md:gap-4 lg:max-w-175 lg:gap-3"
        >
          <div
            class="flex items-center gap-3 text-sm md:gap-4 lg:gap-5 lg:text-base"
          >
            <span>Created by</span>
            <SoftwareMansionMark />
          </div>
          <Heading level={1} punctuation="." class="text-ink self-stretch">
            Elixir in your browser
          </Heading>
        </div>

        <p
          class="max-w-135 text-center text-base leading-6 md:text-lg md:leading-7 lg:max-w-150 lg:text-base lg:leading-6"
        >
          Popcorn runs Erlang/OTP in WebAssembly, allowing you to reuse your
          Elixir code on frontend.
        </p>
      </header>

      <div
        class="flex w-full flex-col items-center gap-4 px-6 md:px-0 lg:gap-10"
      >
        <div class="w-full md:max-w-118 lg:max-w-125">
          <InstallCommand />
        </div>

        <div
          class="flex w-full flex-col gap-2 md:max-w-118 md:flex-row md:gap-3 lg:w-auto lg:max-w-none lg:gap-4"
        >
          <a
            href="#demos"
            class="bg-ink text-cream flex items-center justify-center rounded-full px-5 py-4 text-base font-medium md:flex-1 md:py-3 lg:flex-none lg:px-6 lg:py-2.5"
          >
            Try the examples
          </a>
          <a
            href="/docs"
            class="outline-ink bg-cream text-ink flex items-center justify-center rounded-full px-5 py-4 text-base font-medium outline-1 -outline-offset-1 md:flex-1 md:py-3 lg:flex-none lg:px-6 lg:py-2.5"
          >
            Read the documentation
          </a>
        </div>
      </div>
    </div>

    <div class="w-full px-6 lg:px-0">
      <HeroVideo />
    </div>
  </div>
</section>
