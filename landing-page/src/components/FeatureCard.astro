---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<article
  class="border-brown-80 text-cream-muted flex flex-col gap-2.5 border-b py-6 text-sm leading-6 last:border-b-0 md:min-h-66 md:gap-3 md:py-8 md:odd:pr-8 md:even:border-l md:even:pl-8 md:nth-[n+3]:border-b-0 lg:pt-9 lg:pb-10 lg:text-base lg:leading-7 lg:odd:pr-14 lg:even:pl-14"
>
  <h3
    class="font-display text-cream text-lg leading-7 font-semibold tracking-tight lg:text-2xl lg:leading-8"
  >
    {title}
  </h3>
  <slot />
</article>
