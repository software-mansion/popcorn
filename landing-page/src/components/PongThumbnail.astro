---
import MovieThumbnail from "./MovieThumbnail.astro";
---

<MovieThumbnail title="Pong on LiveView" demo="pong">
  <span class="pong-preview" aria-hidden="true">
    <span class="net"
      ><span></span><span></span><span></span><span></span><span></span></span
    >
    <span class="paddle left"></span>
    <span class="paddle right"></span>
    <span class="ball"></span>
  </span>
</MovieThumbnail>

<style>
  .pong-preview {
    position: relative;
    width: 100%;
    height: 104px;
    margin: auto 14px;
    overflow: hidden;
  }

  .net {
    position: absolute;
    top: 6px;
    bottom: 6px;
    left: 50%;
    display: flex;
    width: 2px;
    flex-direction: column;
    justify-content: space-between;
  }

  .net > span {
    height: 12px;
    background: var(--color-brown-70);
  }

  .paddle,
  .ball {
    position: absolute;
  }

  .paddle {
    top: 18px;
    left: 4%;
    width: 7px;
    height: 42px;
    border-radius: 2px;
  }

  .paddle.left {
    background: var(--color-orange);
  }

  .paddle.right {
    top: 46px;
    right: 4%;
    left: auto;
    background: var(--color-cream);
  }

  .ball {
    top: 49px;
    left: 72%;
    width: 9px;
    height: 9px;
    background: var(--color-cream);
  }

  @container demos (min-width: 1318px) {
    .pong-preview {
      height: 156px;
      margin: auto 20px;
    }

    .paddle {
      width: 10px;
      height: 62px;
    }

    .paddle.left {
      top: 38px;
    }
    .paddle.right {
      top: 62px;
    }
  }
</style>
