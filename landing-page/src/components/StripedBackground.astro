---
interface Props {
  scalloped?: boolean;
  edgeOnly?: boolean;
}

const { scalloped = false, edgeOnly = false } = Astro.props;

let background = "bg-ink";
let placement = "absolute inset-0 flex overflow-hidden";
let stripeLayout = "flex h-full min-w-0 flex-1 flex-col";

if (edgeOnly) {
  background = "bg-transparent";
  placement = "absolute inset-x-0 top-0 flex overflow-hidden";
  stripeLayout = "min-w-0 flex-1";
}

const stripes = Array.from({ length: 64 }, (_, index) => {
  let color = "bg-cream";

  if (index % 2 === 0) {
    color = "bg-cream-soft";
  }

  return { color, index };
});
---

<div
  class:list={[background, placement]}
  data-stripe-background
  aria-hidden="true"
>
  <span class="invisible absolute w-19 md:w-23 lg:w-28" data-stripe-probe
  ></span>
  {
    stripes.map(({ color, index }) => (
      <span class={stripeLayout} data-stripe hidden={index >= 13}>
        {edgeOnly ? (
          <span
            class:list={["block aspect-2/1 w-full rounded-b-full", color]}
          />
        ) : (
          <span class:list={["min-h-0 flex-1", color]} />
        )}
        {scalloped && !edgeOnly && (
          <span
            class:list={["aspect-2/1 w-full flex-none rounded-b-full", color]}
          />
        )}
      </span>
    ))
  }
</div>

<script is:inline>
  {
    const script = document.currentScript;
    const background = script.previousElementSibling;
    const probe = background.querySelector("[data-stripe-probe]");
    const stripes = background.querySelectorAll("[data-stripe]");

    function updateStripeCount() {
      if (!probe.offsetWidth) return;

      const count = Math.floor(window.innerWidth / probe.offsetWidth);

      console.assert(count <= stripes.length);
      for (let index = 0; index < stripes.length; index += 1) {
        stripes[index].hidden = index >= count;
      }
    }

    updateStripeCount();
    new ResizeObserver(updateStripeCount).observe(background);
  }
</script>
