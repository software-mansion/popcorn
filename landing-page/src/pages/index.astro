---
import Heading from "../components/Heading.astro";
import Hero from "../components/Hero.astro";
import FeatureCard from "../components/FeatureCard.astro";
import Footer from "../components/Footer.astro";
import MovieStrip from "../components/MovieStrip.astro";
import UseCaseCard from "../components/UseCaseCard.astro";
import SectionPlaceholder from "../components/SectionPlaceholder.astro";
import StripedBackground from "../components/StripedBackground.astro";
import Layout from "../layouts/Layout.astro";

const features = [
  {
    position: "top-left" as const,
    title: "Just plain Elixir",
    description:
      "Supervisors, GenServers, and any other OTP components just work. The VM runs off the browser's main thread, so a busy process never freezes the page.",
  },
  {
    position: "top-right" as const,
    title: "Optimised for the web",
    description:
      "Under 1 MB of compressed Wasm, with ~2.9 MB for Elixir and the OTP standard library. It boots in about 200 ms. Getting there meant cutting what the browser has no use for — native sockets, distribution, dynamic module loading, crash dumps.",
    linkText: "Read optimization blogpost",
  },
  {
    position: "bottom-left" as const,
    title: "Your dependencies come with you",
    description:
      "Req, Jason, Ecto, even Phoenix Live View compile and run unmodified. The bundler packs your whole dependency closure, so there's nothing to list.",
    note: "Browser requests use fetch() automatically.",
  },
  {
    position: "bottom-right" as const,
    title: "Call Elixir from JavaScript (and vice versa)",
    description:
      "Communicate with Elixir processes, exchange data, run JS from Elixir code.",
    code: [
      'const result = await popcorn.genserver.call("counter", ["add", 1]);',
      "if (result.ok) console.log(result.data);",
    ],
  },
];

const useCases = [
  {
    label: "Local LiveView",
    variant: "a" as const,
    title: "Use LiveView in the frontend",
    description:
      "You can use familiar Phoenix LiveViews to create local UI. Makes your app work even when the internet connection is spotty.",
  },
  {
    label: "Elixir Language Tour",
    variant: "b" as const,
    title: "Learn Elixir",
    description:
      "We created Elixir Language Tour for Elixir newcomers. It's a great start to learn functional programming. It covers base types, pattern matching, functions, processes, and OTP patterns. Uses Popcorn under the hood.",
  },
];
---

<Layout>
  <Hero />

  <section
    id="features"
    class="bg-ink flex flex-col items-center gap-8 px-5 pt-16 md:h-177 md:gap-10 md:px-8 md:py-20 lg:h-205 lg:gap-16 lg:px-16 lg:pt-28 lg:pb-0"
  >
    <Heading punctuation="?" class="text-cream">Features</Heading>

    <div
      class="grid w-full max-w-352 grid-cols-1 gap-4 md:grid-cols-2 md:gap-5 lg:gap-0"
    >
      {features.map((feature) => <FeatureCard {...feature} />)}
    </div>
  </section>

  <section
    id="use-cases"
    class="bg-ink flex flex-col items-center gap-8 px-5 pt-20 pb-22 md:gap-10 md:px-8 md:pt-0 md:pb-24 lg:gap-16 lg:px-16 lg:pt-28 lg:pb-35"
  >
    <Heading punctuation="." class="text-cream">Use cases</Heading>

    <div
      class="mx-auto grid w-full max-w-352 auto-rows-fr grid-cols-1 gap-4 md:grid-cols-2 md:gap-5 lg:gap-16"
    >
      {useCases.map((useCase) => <UseCaseCard {...useCase} />)}
    </div>
  </section>

  <section
    id="demos"
    class="bg-cream relative flex flex-col items-center gap-7 overflow-hidden pt-16 pb-18 md:gap-9 md:pt-20 md:pb-22 lg:gap-16 lg:pt-28 lg:pb-28"
  >
    <StripedBackground />

    <Heading punctuation="!" class="text-ink relative z-10 w-full px-5">
      Demos
    </Heading>

    <div class="@container/demos relative z-10 mx-auto w-full max-w-352">
      <div
        class="@min-demos/demos:flex-row @min-demos/demos:gap-6 flex flex-col gap-7 md:gap-9"
      >
        <MovieStrip />
        <div
          class="@min-demos/demos:h-203 @min-demos/demos:flex-1 @min-demos/demos:p-0 h-85 px-3 md:h-116 md:px-6"
        >
          <SectionPlaceholder label="Demo placeholder" class="h-full w-full" />
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
