---
import { Code } from "astro:components";

import Heading from "../components/Heading.astro";
import Hero from "../components/Hero.astro";
import GameOfLifeDemo from "../components/GameOfLifeDemo.astro";
import IexDemo from "../components/IexDemo.astro";
import FeatureCard from "../components/FeatureCard.astro";
import Footer from "../components/Footer.astro";
import MovieStrip from "../components/MovieStrip.astro";
import PongDemo from "../components/PongDemo.astro";
import UseCaseCard from "../components/UseCaseCard.astro";
import StripedBackground from "../components/StripedBackground.astro";
import Layout from "../layouts/Layout.astro";

const popcornTheme = {
  name: "popcorn",
  type: "dark",
  colors: {
    "editor.background": "var(--color-brown-90)",
    "editor.foreground": "var(--color-cream-muted)",
  },
  tokenColors: [
    {
      scope: ["keyword", "storage.type"],
      settings: { foreground: "var(--color-orange)" },
    },
    {
      scope: ["string", "constant.numeric"],
      settings: { foreground: "var(--color-cream)" },
    },
    {
      scope: "entity.name.function",
      settings: { foreground: "var(--color-orange-20)" },
    },
  ],
} as const;

const interopCode = `const result =
  await popcorn.genserver.call(
    "counter",
    ["add", 1],
  );
if (result.ok) {
  console.log(result.data);
}`;

const useCases = [
  {
    label: "Local LiveView",
    variant: "a" as const,
    title: "Use LiveView in the frontend",
    description:
      "You can use familiar Phoenix LiveViews to create local UI. Makes your app work even when the internet connection is spotty.",
  },
  {
    label: "Elixir Language Tour",
    variant: "b" as const,
    title: "Learn Elixir",
    description:
      "We created Elixir Language Tour for Elixir newcomers. It's a great start to learn functional programming. It covers base types, pattern matching, functions, processes, and OTP patterns. Uses Popcorn under the hood.",
  },
];
---

<Layout>
  <Hero />

  <section
    id="features"
    class="bg-ink flex flex-col items-center gap-8 px-5 pt-16 md:gap-10 md:px-8 md:py-20 lg:h-205 lg:gap-16 lg:px-16 lg:pt-28 lg:pb-0"
    data-background="dark"
  >
    <Heading punctuation="?" class="text-cream">Features</Heading>

    <div class="grid w-full max-w-352 grid-cols-1 md:grid-cols-2">
      <FeatureCard title="Just plain Elixir">
        <p>
          Supervisors, GenServers, and any other OTP components just work. The
          VM runs off the browser's main thread, so a busy process never freezes
          the page.
        </p>
      </FeatureCard>

      <FeatureCard title="Optimised for the web">
        <p>
          Under <span class="font-bold">1 MB</span> of compressed Wasm, with around
          <span class="font-bold"> 2.9 MB</span> for Elixir and the OTP standard library.
          It boots in about <span class="font-bold">200 ms</span>. Getting there
          meant cutting what the browser has no use for — native sockets,
          distribution, dynamic module loading, crash dumps.
        </p>
        <a
          href="#"
          class="text-orange mt-2 hidden text-sm leading-4 font-medium lg:block"
        >
          Read optimization blogpost →
        </a>
      </FeatureCard>

      <FeatureCard title="Your dependencies come with you">
        <p>
          Req, Jason, Ecto, even Phoenix Live View compile and run unmodified.
          The bundler packs your whole dependency closure, so there's nothing to
          list.
        </p>
        <p class="hidden lg:block">
          Requests coming from Elixir use <code class="text-orange"
            >fetch()</code
          > automatically.
        </p>
      </FeatureCard>

      <FeatureCard title="Call Elixir from JavaScript (and vice versa)">
        <p>
          Communicate with Elixir processes, exchange data, run JS from Elixir
          code.
        </p>
        <Code
          code={interopCode}
          lang="javascript"
          theme={popcornTheme}
          class="font-label block overflow-x-auto rounded-md px-4 py-3 text-xs leading-4 lg:text-sm lg:leading-5"
        />
      </FeatureCard>
    </div>
  </section>

  <section
    id="use-cases"
    class="bg-ink flex flex-col items-center gap-8 px-5 pt-20 pb-22 md:gap-10 md:px-8 md:pt-0 md:pb-24 lg:gap-16 lg:px-16 lg:pt-28 lg:pb-35"
    data-background="dark"
  >
    <Heading punctuation="." class="text-cream">Use cases</Heading>

    <div
      class="mx-auto grid w-full max-w-352 auto-rows-fr grid-cols-1 gap-4 md:grid-cols-2 md:gap-5 lg:gap-16"
    >
      {useCases.map((useCase) => <UseCaseCard {...useCase} />)}
    </div>
  </section>

  <section
    id="demos"
    class="bg-cream relative flex flex-col items-center gap-7 overflow-hidden pt-16 pb-18 md:gap-9 md:pt-20 md:pb-22 lg:gap-16 lg:pt-28 lg:pb-28"
  >
    <StripedBackground />

    <Heading punctuation="!" class="text-ink relative z-10 w-full px-5">
      Demos
    </Heading>

    <div
      class="@container/demos relative z-10 mx-auto w-full max-w-352 px-3 md:px-6 2xl:max-w-480 2xl:px-0"
    >
      <div
        class="@min-demos/demos:max-w-none @min-demos/demos:flex-row @min-demos/demos:gap-6 mx-auto flex max-w-208 flex-col gap-7 md:gap-9"
      >
        <MovieStrip />
        <div class="@min-demos/demos:flex-1 relative min-w-0" data-demo-stage>
          <div
            class="@min-demos/demos:h-203 h-85 md:h-116"
            data-demo-panel="iex"
          >
            <IexDemo />
          </div>
          <div
            class="@min-demos/demos:h-203 md:h-208"
            data-demo-panel="game-of-life"
            aria-hidden="true"
            inert
            hidden
          >
            <GameOfLifeDemo />
          </div>
          <div data-demo-panel="pong" aria-hidden="true" inert hidden>
            <PongDemo />
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
