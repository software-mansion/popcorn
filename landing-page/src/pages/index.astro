---
import Heading from "../components/Heading.astro";
import Hero from "../components/Hero.astro";
import SectionPlaceholder from "../components/SectionPlaceholder.astro";
import StripedBackground from "../components/StripedBackground.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <Hero />

  <section
    class="bg-ink flex h-242 flex-col items-center gap-8 px-5 pt-16 md:h-177 md:gap-10 md:px-8 md:py-20 lg:h-205 lg:gap-16 lg:px-16 lg:pt-28 lg:pb-0"
  >
    <Heading punctuation="?" class="text-cream">Features</Heading>

    <div
      class="mx-auto grid w-full max-w-352 grid-cols-1 gap-4 md:grid-cols-2 md:gap-5 lg:grid-rows-2 lg:gap-16"
    >
      <SectionPlaceholder
        label="Feature placeholder"
        class="h-46 md:h-58 lg:h-65"
      />
      <SectionPlaceholder label="Feature placeholder" class="h-58 lg:h-65" />
      <SectionPlaceholder label="Feature placeholder" class="h-52 lg:h-65" />
      <SectionPlaceholder
        label="Feature placeholder"
        class="h-40 md:h-52 lg:h-65"
      />
    </div>
  </section>

  <section
    id="use-cases"
    class="bg-ink flex h-186 flex-col items-center gap-8 px-5 pt-20 pb-22 md:h-104 md:gap-10 md:px-8 md:pt-0 md:pb-24 lg:h-150 lg:gap-16 lg:px-16 lg:pt-28 lg:pb-34"
  >
    <Heading punctuation="." class="text-cream">Use cases</Heading>

    <div
      class="mx-auto grid w-full max-w-352 grid-cols-1 gap-4 md:grid-cols-2 md:gap-5 lg:gap-16"
    >
      <SectionPlaceholder
        label="Use case placeholder"
        class="h-64 md:h-58 lg:h-51"
      />
      <SectionPlaceholder label="Use case placeholder" class="h-58" />
    </div>
  </section>

  <section
    id="demos"
    class="bg-cream relative flex h-205 flex-col items-center gap-7 overflow-hidden pt-16 pb-18 md:h-250 md:gap-9 md:pt-20 md:pb-22 lg:h-289 lg:gap-16 lg:px-16 lg:pt-28 lg:pb-28"
  >
    <StripedBackground />

    <Heading punctuation="!" class="text-ink relative z-10 w-full px-5">
      Demos
    </Heading>

    <div
      class="relative z-10 mx-auto flex w-full max-w-352 flex-col gap-7 md:gap-9 lg:flex-row lg:gap-6"
    >
      <SectionPlaceholder
        label="Movie strip placeholder"
        class="h-62 w-full rounded-none lg:h-203 lg:w-115 lg:flex-none lg:rounded-2xl"
      />
      <div class="px-3 md:px-6 lg:flex-1 lg:px-0">
        <SectionPlaceholder
          label="Demo placeholder"
          class="h-85 w-full md:h-116 lg:h-203"
        />
      </div>
    </div>
  </section>

  <footer
    class="bg-ink flex h-195 justify-center px-6 pt-16 md:h-159 md:px-8 lg:h-200 lg:px-16 lg:pt-35"
  >
    <SectionPlaceholder
      label="Footer content placeholder"
      class="h-73 w-full max-w-175 md:h-49 md:max-w-150 lg:h-74 lg:max-w-175"
    />
  </footer>
</Layout>
