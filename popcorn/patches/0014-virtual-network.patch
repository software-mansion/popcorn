diff --git a/lib/kernel/src/wasm_socket.erl b/lib/kernel/src/wasm_socket.erl
new file mode 100644
index 0000000000000000000000000000000000000000..5f3532fa166f715d305bfbb1cbf3d2e0dd33dddd
--- /dev/null
+++ b/lib/kernel/src/wasm_socket.erl
@@ -0,0 +1,441 @@
+-module(wasm_socket).
+-moduledoc false.
+
+-export([tcp_listen/2, tcp_connect/4, udp_open/2, accept/2,
+         call/2, call/3, cast/2]).
+
+-define(QUEUE_LIMIT_BYTES, 1024 * 1024).
+
+tcp_listen(Port, Opts) ->
+    start({tcp_listener, Port, Opts}, self()).
+
+tcp_connect(Address, Port, Opts, Timeout) ->
+    start({tcp, Address, Port, Opts, Timeout}, self()).
+
+udp_open(Port, Opts) ->
+    start({udp, Port, Opts}, self()).
+
+accept(Socket, Timeout) ->
+    call(Socket, {accept, Timeout}, infinity).
+
+call({'$inet', _Module, Pid}, Request) ->
+    call(Pid, Request, infinity).
+
+call({'$inet', _Module, Pid}, Request, Timeout) ->
+    call(Pid, Request, Timeout);
+call(Pid, Request, Timeout) when is_pid(Pid) ->
+    Ref = make_ref(),
+    Pid ! {socket_call, self(), Ref, Request},
+    receive
+        {socket_reply, Ref, Reply} -> Reply
+    after Timeout ->
+        {error, timeout}
+    end.
+
+cast({'$inet', _Module, Pid}, Request) ->
+    Pid ! {socket_cast, self(), Request},
+    ok.
+
+start(Spec, Owner) ->
+    Parent = self(),
+    Ref = make_ref(),
+    Pid = spawn(fun() -> init(Parent, Ref, Owner, Spec) end),
+    receive
+        {socket_started, Ref, {ok, Module}} -> {ok, {'$inet', Module, Pid}};
+        {socket_started, Ref, Error} -> Error
+    end.
+
+init(Parent, Ref, Owner, Spec) ->
+    {ok, Id} = wasm_virtual_network:open_socket(self()),
+    case open(Id, Owner, Spec) of
+        {ok, State} ->
+            Parent ! {socket_started, Ref, {ok, module(State)}},
+            loop(State);
+        {error, _} = Error ->
+            ok = wasm_virtual_network:close_socket(Id),
+            Parent ! {socket_started, Ref, Error}
+    end.
+
+open(Id, Owner, {tcp_listener, Port, Opts}) ->
+    case options(Opts, tcp_listener) of
+        {ok, Options, Address, Backlog} ->
+            Operation = #{operation => listen_tcp, address => address(Address),
+                          port => Port, backlog => Backlog},
+            case wasm_virtual_network:request(Id, Operation, <<>>, infinity) of
+                {ok, Event} ->
+                    {ok, state(tcp_listener, Id, Owner, Options,
+                               endpoint(Event), undefined)};
+                Error -> Error
+            end;
+        Error -> Error
+    end;
+open(Id, Owner, {tcp, Address, Port, Opts, Timeout}) ->
+    case options(Opts, tcp) of
+        {ok, Options, LocalAddress, _Backlog} ->
+            Operation = #{operation => connect_tcp, address => address(Address),
+                          port => Port},
+            case wasm_virtual_network:request(Id, Operation, <<>>, Timeout) of
+                {ok, Event} ->
+                    Local = local_endpoint(Event, LocalAddress),
+                    {ok, state(tcp, Id, Owner, Options, Local, endpoint(Event))};
+                Error -> Error
+            end;
+        Error -> Error
+    end;
+open(Id, Owner, {udp, Port, Opts}) ->
+    case options(Opts, udp) of
+        {ok, Options, Address, _Backlog} ->
+            Operation = #{operation => bind_udp, address => address(Address), port => Port},
+            case wasm_virtual_network:request(Id, Operation, <<>>, infinity) of
+                {ok, Event} ->
+                    {ok, state(udp, Id, Owner, Options, endpoint(Event), undefined)};
+                Error -> Error
+            end;
+        Error -> Error
+    end.
+
+state(Kind, Id, Owner, Options, Local, Peer) ->
+    #{kind => Kind, id => Id, owner => Owner, owner_mon => monitor(process, Owner),
+      options => Options, local => Local, peer => Peer, buffer => <<>>,
+      datagrams => queue:new(), recv => undefined, closed => false}.
+
+module(#{kind := udp}) -> wasm_udp;
+module(_) -> wasm_tcp.
+
+loop(State) ->
+    receive
+        {socket_call, From, Ref, Request} ->
+            case handle_call(From, Ref, Request, State) of
+                {reply, Reply, Next} -> From ! {socket_reply, Ref, Reply}, loop(deliver(Next));
+                {noreply, Next} -> loop(Next);
+                stop -> ok
+            end;
+        {socket_cast, From, close} ->
+            close(State), From ! {socket_closed, self()};
+        {network_event, Event, Bytes} ->
+            loop(deliver(handle_event(Event, Bytes, State)));
+        {recv_timeout, Ref} ->
+            loop(timeout_recv(Ref, State));
+        {'DOWN', Mon, process, _Pid, _Reason} when Mon =:= map_get(owner_mon, State) ->
+            close(State);
+        _ -> loop(State)
+    end.
+
+handle_call(_From, _Ref, close, State) ->
+    close(State), stop;
+handle_call(From, _Ref, {accept, Timeout}, #{kind := tcp_listener} = State) ->
+    case start_pending(From, maps:get(options, State), maps:get(local, State)) of
+        {ok, Pid, Id, Socket} ->
+            Operation = #{operation => accept_tcp, acceptedSocketId => Id},
+            case wasm_virtual_network:request(maps:get(id, State), Operation, <<>>, Timeout) of
+                {ok, Event} ->
+                    Pid ! {accepted, endpoint(Event)},
+                    {reply, {ok, Socket}, State};
+                Error ->
+                    Pid ! abort,
+                    {reply, Error, State}
+            end;
+        Error -> {reply, Error, State}
+    end;
+handle_call(_From, _Ref, {accept, _Timeout}, State) ->
+    {reply, {error, einval}, State};
+handle_call(_From, _Ref, {send, Data}, #{kind := tcp, closed := false} = State) ->
+    case encode_packet(Data, maps:get(packet, maps:get(options, State))) of
+        {ok, Bytes} ->
+            ok = wasm_virtual_network:send(maps:get(id, State),
+                                            #{operation => tcp_data}, Bytes),
+            {reply, ok, State};
+        Error -> {reply, Error, State}
+    end;
+handle_call(_From, _Ref, {send, _Data}, State) ->
+    {reply, {error, closed}, State};
+handle_call(From, Ref, {recv, Length, Timeout}, State) ->
+    recv(From, Ref, Length, Timeout, State);
+handle_call(_From, _Ref, {udp_send, Address, Port, Data}, #{kind := udp} = State) ->
+    Bytes = iolist_to_binary(Data),
+    case byte_size(Bytes) =< ?QUEUE_LIMIT_BYTES of
+        true ->
+            ok = wasm_virtual_network:send(maps:get(id, State),
+                                            #{operation => udp_data,
+                                              address => address(Address),
+                                              port => Port}, Bytes),
+            {reply, ok, State};
+        false -> {reply, {error, enobufs}, State}
+    end;
+handle_call(_From, _Ref, {udp_connect, Address, Port}, #{kind := udp} = State) ->
+    {reply, ok, State#{peer := {parse_address(Address), Port}}};
+handle_call(From, Ref, {udp_recv, Length, Timeout}, #{kind := udp} = State) ->
+    recv(From, Ref, Length, Timeout, State);
+handle_call(From, _Ref, {controlling_process, NewOwner}, State) ->
+    case From =:= maps:get(owner, State) andalso is_process_alive(NewOwner) of
+        true ->
+            demonitor(maps:get(owner_mon, State), [flush]),
+            {reply, ok, State#{owner := NewOwner,
+                               owner_mon := monitor(process, NewOwner)}};
+        false when From =/= map_get(owner, State) -> {reply, {error, not_owner}, State};
+        false -> {reply, {error, badarg}, State}
+    end;
+handle_call(_From, _Ref, {setopts, Opts}, State) ->
+    case update_options(Opts, maps:get(options, State)) of
+        {ok, Options} -> {reply, ok, State#{options := Options}};
+        Error -> {reply, Error, State}
+    end;
+handle_call(_From, _Ref, {getopts, Names}, State) ->
+    Options = maps:get(options, State),
+    {reply, get_options(Names, Options), State};
+handle_call(_From, _Ref, sockname, State) ->
+    {reply, {ok, maps:get(local, State)}, State};
+handle_call(_From, _Ref, peername, #{peer := undefined} = State) ->
+    {reply, {error, enotconn}, State};
+handle_call(_From, _Ref, peername, State) ->
+    {reply, {ok, maps:get(peer, State)}, State};
+handle_call(_From, _Ref, {shutdown, How}, #{kind := tcp} = State)
+  when How =:= read; How =:= write; How =:= read_write ->
+    ok = wasm_virtual_network:send(maps:get(id, State),
+                                   #{operation => close, direction => How}, <<>>),
+    {reply, ok, State};
+handle_call(_From, _Ref, _Request, State) ->
+    {reply, {error, enotsup}, State}.
+
+start_pending(Owner, Options, Local) ->
+    Parent = self(),
+    Ref = make_ref(),
+    Pid = spawn(fun() -> pending(Parent, Ref, Owner, Options, Local) end),
+    receive
+        {pending_started, Ref, Id} -> {ok, Pid, Id, {'$inet', wasm_tcp, Pid}}
+    end.
+
+pending(Parent, Ref, Owner, Options, Local) ->
+    {ok, Id} = wasm_virtual_network:open_socket(self()),
+    Parent ! {pending_started, Ref, Id},
+    receive
+        {accepted, Peer} -> loop(state(tcp, Id, Owner, Options, Local, Peer));
+        abort ->
+            wasm_virtual_network:send(Id, #{operation => close,
+                                            direction => read_write}, <<>>),
+            wasm_virtual_network:close_socket(Id)
+    end.
+
+recv(_From, _Ref, _Length, _Timeout, #{options := #{active := Active}} = State)
+  when Active =/= false ->
+    {reply, {error, einval}, State};
+recv(_From, _Ref, _Length, _Timeout, #{recv := Recv} = State)
+  when Recv =/= undefined ->
+    {reply, {error, ealready}, State};
+recv(From, Ref, Length, Timeout, State) ->
+    case take_passive(Length, State) of
+        {ok, Value, Next} -> {reply, {ok, Value}, Next};
+        closed -> {reply, {error, closed}, State};
+        wait ->
+            Timer = case Timeout of infinity -> undefined;
+                       _ -> erlang:send_after(Timeout, self(), {recv_timeout, Ref})
+                    end,
+            {noreply, State#{recv := {From, Ref, Length, Timer}}}
+    end.
+
+timeout_recv(Ref, #{recv := {From, Ref, _Length, _Timer}} = State) ->
+    From ! {socket_reply, Ref, {error, timeout}},
+    State#{recv := undefined};
+timeout_recv(_Ref, State) -> State.
+
+handle_event(#{<<"operation">> := <<"tcp_data">>}, Bytes, State) ->
+    State#{buffer := <<(maps:get(buffer, State))/binary, Bytes/binary>>};
+handle_event(#{<<"operation">> := <<"udp_data">>,
+               <<"address">> := Address, <<"port">> := Port}, Bytes, State) ->
+    Datagram = {parse_ip(Address), Port, Bytes},
+    State#{datagrams := queue:in(Datagram, maps:get(datagrams, State))};
+handle_event(#{<<"operation">> := <<"tcp_closed">>} = Event, _Bytes, State) ->
+    Reason = case maps:find(<<"reason">>, Event) of
+                 {ok, Binary} -> network_reason(Binary);
+                 error -> closed
+             end,
+    State#{closed := Reason};
+handle_event(_Event, _Bytes, State) -> State.
+
+deliver(#{recv := {From, Ref, Length, Timer}} = State) ->
+    case take_passive(Length, State#{recv := undefined}) of
+        {ok, Value, Next} ->
+            cancel_timer(Timer), From ! {socket_reply, Ref, {ok, Value}}, Next;
+        closed ->
+            cancel_timer(Timer), From ! {socket_reply, Ref, {error, closed}},
+            State#{recv := undefined};
+        wait -> deliver_active(State)
+    end;
+deliver(State) -> deliver_active(State).
+
+deliver_active(#{options := #{active := false}} = State) -> State;
+deliver_active(#{kind := udp} = State) -> deliver_active_udp(State);
+deliver_active(State) -> deliver_active_tcp(State).
+
+deliver_active_tcp(State) ->
+    case take_tcp(0, State) of
+        {ok, Value, Next} ->
+            Owner = maps:get(owner, State), Handle = {'$inet', wasm_tcp, self()},
+            Owner ! {tcp, Handle, Value},
+            continue_active(Next);
+        closed ->
+            maps:get(owner, State) ! {tcp_closed, {'$inet', wasm_tcp, self()}}, State;
+        wait -> State
+    end.
+
+deliver_active_udp(State) ->
+    case take_udp(0, State) of
+        {ok, {Address, Port, Value}, Next} ->
+            maps:get(owner, State) ! {udp, {'$inet', wasm_udp, self()}, Address, Port, Value},
+            continue_active(Next);
+        wait -> State
+    end.
+
+continue_active(#{options := #{active := once} = Options} = State) ->
+    State#{options := Options#{active := false}};
+continue_active(#{options := #{active := 1} = Options} = State) ->
+    Owner = maps:get(owner, State),
+    Owner ! {tcp_passive, {'$inet', wasm_tcp, self()}},
+    State#{options := Options#{active := false}};
+continue_active(#{options := #{active := Active} = Options} = State)
+  when is_integer(Active) ->
+    deliver_active(State#{options := Options#{active := Active - 1}});
+continue_active(State) -> deliver_active(State).
+
+take_passive(Length, #{kind := udp} = State) -> take_udp(Length, State);
+take_passive(Length, State) -> take_tcp(Length, State).
+
+take_udp(Length, State) ->
+    case queue:out(maps:get(datagrams, State)) of
+        {{value, {Address, Port, Bytes}}, Rest} ->
+            Data = mode(truncate(Bytes, Length), State),
+            {ok, {Address, Port, Data}, State#{datagrams := Rest}};
+        {empty, _} -> wait
+    end.
+
+take_tcp(Length, State) ->
+    Packet = maps:get(packet, maps:get(options, State)),
+    case extract_packet(maps:get(buffer, State), Packet, Length,
+                        maps:get(closed, State)) of
+        {ok, Bytes, Rest} -> {ok, mode(Bytes, State), State#{buffer := Rest}};
+        closed -> closed;
+        wait -> wait
+    end.
+
+extract_packet(Buffer, raw, 0, _Closed) when byte_size(Buffer) > 0 ->
+    {ok, Buffer, <<>>};
+extract_packet(Buffer, raw, Length, _Closed) when byte_size(Buffer) >= Length,
+                                                   Length > 0 ->
+    <<Value:Length/binary, Rest/binary>> = Buffer, {ok, Value, Rest};
+extract_packet(Buffer, raw, _Length, Closed) when Closed =/= false,
+                                                  byte_size(Buffer) > 0 ->
+    {ok, Buffer, <<>>};
+extract_packet(<<>>, _Packet, _Length, Closed) when Closed =/= false -> closed;
+extract_packet(Buffer, Packet, _Length, _Closed) when is_integer(Packet) ->
+    case Buffer of
+        <<Size:Packet/unit:8, Rest/binary>> when byte_size(Rest) >= Size ->
+            <<Value:Size/binary, Tail/binary>> = Rest, {ok, Value, Tail};
+        _ -> wait
+    end;
+extract_packet(_Buffer, _Packet, _Length, _Closed) -> wait.
+
+encode_packet(Data, raw) -> {ok, iolist_to_binary(Data)};
+encode_packet(Data, Packet) when is_integer(Packet) ->
+    Bytes = iolist_to_binary(Data), Size = byte_size(Bytes),
+    case Size < (1 bsl (Packet * 8)) of
+        true -> {ok, <<Size:Packet/unit:8, Bytes/binary>>};
+        false -> {error, emsgsize}
+    end.
+
+mode(Bytes, #{options := #{mode := binary}}) -> Bytes;
+mode(Bytes, _State) -> binary_to_list(Bytes).
+
+options(Opts, Kind) when is_list(Opts) ->
+    Defaults = #{active => true, mode => list, packet => raw},
+    parse_options(Opts, Defaults, any, 5, Kind).
+
+parse_options([], Options, Address, Backlog, _Kind) ->
+    {ok, Options, Address, Backlog};
+parse_options([binary | Rest], Options, Address, Backlog, Kind) ->
+    parse_options(Rest, Options#{mode := binary}, Address, Backlog, Kind);
+parse_options([list | Rest], Options, Address, Backlog, Kind) ->
+    parse_options(Rest, Options#{mode := list}, Address, Backlog, Kind);
+parse_options([{active, Active} | Rest], Options, Address, Backlog, Kind)
+  when Active =:= true; Active =:= false; Active =:= once ->
+    parse_options(Rest, Options#{active := Active}, Address, Backlog, Kind);
+parse_options([{active, Active} | Rest], Options, Address, Backlog, Kind)
+  when is_integer(Active), Active > 0 ->
+    parse_options(Rest, Options#{active := Active}, Address, Backlog, Kind);
+parse_options([{packet, Packet} | Rest], Options, Address, Backlog, Kind)
+  when Packet =:= raw; Packet =:= 0; Packet =:= 1; Packet =:= 2; Packet =:= 4 ->
+    Value = case Packet of 0 -> raw; _ -> Packet end,
+    parse_options(Rest, Options#{packet := Value}, Address, Backlog, Kind);
+parse_options([{ip, Address} | Rest], Options, _Old, Backlog, Kind) ->
+    parse_options(Rest, Options, Address, Backlog, Kind);
+parse_options([{ifaddr, Address} | Rest], Options, _Old, Backlog, Kind) ->
+    parse_options(Rest, Options, Address, Backlog, Kind);
+parse_options([{backlog, Backlog} | Rest], Options, Address, _Old, tcp_listener)
+  when is_integer(Backlog), Backlog >= 0 ->
+    parse_options(Rest, Options, Address, Backlog, tcp_listener);
+parse_options([inet | Rest], Options, Address, Backlog, Kind) ->
+    parse_options(Rest, Options, Address, Backlog, Kind);
+parse_options([{Name, _Value} | Rest], Options, Address, Backlog, Kind)
+  when Name =:= reuseaddr; Name =:= nodelay; Name =:= send_timeout;
+       Name =:= send_timeout_close; Name =:= buffer ->
+    parse_options(Rest, Options, Address, Backlog, Kind);
+parse_options([_Unsupported | _], _Options, _Address, _Backlog, _Kind) ->
+    {error, enotsup}.
+
+update_options(Opts, Options) ->
+    case parse_options(Opts, Options, any, 5, update) of
+        {ok, New, _Address, _Backlog} -> {ok, New};
+        Error -> Error
+    end.
+
+get_options(Names, Options) ->
+    try {ok, [{Name, maps:get(option_name(Name), Options)} || Name <- Names]}
+    catch error:{badkey, _} -> {error, enotsup}
+    end.
+
+option_name(active) -> active;
+option_name(mode) -> mode;
+option_name(packet) -> packet.
+
+close(State) ->
+    Id = maps:get(id, State),
+    wasm_virtual_network:send(Id, #{operation => close, direction => read_write}, <<>>),
+    wasm_virtual_network:close_socket(Id),
+    ok.
+
+cancel_timer(undefined) -> ok;
+cancel_timer(Timer) -> erlang:cancel_timer(Timer), ok.
+
+endpoint(#{<<"address">> := Address, <<"port">> := Port}) ->
+    {parse_ip(Address), Port}.
+
+local_endpoint(#{<<"localAddress">> := Address, <<"localPort">> := Port}, _Default) ->
+    {parse_ip(Address), Port};
+local_endpoint(_Event, Default) ->
+    {normalize_ip(Default), 0}.
+
+address(any) -> <<"0.0.0.0">>;
+address(loopback) -> <<"127.0.0.1">>;
+address(Address) when is_binary(Address) -> Address;
+address(Address) when is_atom(Address) -> atom_to_binary(Address);
+address(Address) when is_list(Address) -> list_to_binary(Address);
+address({A, B, C, D}) ->
+    iolist_to_binary(io_lib:format("~B.~B.~B.~B", [A, B, C, D])).
+
+normalize_ip(any) -> {0, 0, 0, 0};
+normalize_ip(loopback) -> {127, 0, 0, 1};
+normalize_ip({_, _, _, _} = Address) -> Address.
+
+parse_ip(Address) ->
+    {ok, IP} = inet_parse:ipv4_address(binary_to_list(Address)), IP.
+
+parse_address({_, _, _, _} = Address) -> Address;
+parse_address(loopback) -> {127, 0, 0, 1};
+parse_address(Address) ->
+    parse_ip(address(Address)).
+
+truncate(Bytes, 0) -> Bytes;
+truncate(Bytes, Length) when byte_size(Bytes) =< Length -> Bytes;
+truncate(Bytes, Length) -> binary:part(Bytes, 0, Length).
+
+network_reason(<<"econnreset">>) -> econnreset;
+network_reason(<<"enobufs">>) -> enobufs.
diff --git a/lib/kernel/src/wasm_tcp.erl b/lib/kernel/src/wasm_tcp.erl
new file mode 100644
index 0000000000000000000000000000000000000000..d1564f92c87e0a673fb3130f7e56abd7b1b4939c
--- /dev/null
+++ b/lib/kernel/src/wasm_tcp.erl
@@ -0,0 +1,31 @@
+-module(wasm_tcp).
+-moduledoc false.
+
+-export([connect/3, connect/4, listen/2, accept/2, send/2, recv/3,
+         close/1, shutdown/2, controlling_process/2, setopts/2, getopts/2,
+         sockname/1, peername/1, unrecv/2, fdopen/2]).
+
+connect(#{addr := Address, port := Port}, Opts, Timeout) ->
+    connect(Address, Port, Opts, Timeout).
+
+connect(Address, Port, Opts, Timeout) ->
+    wasm_socket:tcp_connect(Address, Port, Opts, Timeout).
+
+listen(Port, Opts) -> wasm_socket:tcp_listen(Port, Opts).
+accept(Socket, Timeout) -> wasm_socket:accept(Socket, Timeout).
+send(Socket, Data) -> wasm_socket:call(Socket, {send, Data}).
+recv(Socket, Length, Timeout) -> wasm_socket:call(Socket, {recv, Length, Timeout}).
+
+close({'$inet', ?MODULE, Pid} = Socket) ->
+    wasm_socket:cast(Socket, close),
+    receive {socket_closed, Pid} -> ok end.
+
+shutdown(Socket, How) -> wasm_socket:call(Socket, {shutdown, How}).
+controlling_process(Socket, Owner) ->
+    wasm_socket:call(Socket, {controlling_process, Owner}).
+setopts(Socket, Opts) -> wasm_socket:call(Socket, {setopts, Opts}).
+getopts(Socket, Names) -> wasm_socket:call(Socket, {getopts, Names}).
+sockname(Socket) -> wasm_socket:call(Socket, sockname).
+peername(Socket) -> wasm_socket:call(Socket, peername).
+unrecv(_Socket, _Data) -> {error, enotsup}.
+fdopen(_Fd, _Opts) -> {error, enotsup}.
