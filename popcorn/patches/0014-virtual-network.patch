--- /dev/null
+++ b/lib/kernel/src/wasm_udp.erl
@@ -0,0 +1,43 @@
+-module(wasm_udp).
+-moduledoc false.
+
+-export([open/2, close/1, send/2, send/3, send/4, send/5,
+         recv/2, recv/3, connect/3, controlling_process/2,
+         setopts/2, getopts/2, sockname/1, peername/1]).
+
+open(Port, Opts) -> wasm_socket:udp_open(Port, Opts).
+
+close({'$inet', ?MODULE, Pid} = Socket) ->
+    wasm_socket:cast(Socket, close),
+    receive {socket_closed, Pid} -> ok end.
+
+send(Socket, Data) ->
+    case peername(Socket) of
+        {ok, {Address, Port}} -> send(Socket, Address, Port, Data);
+        Error -> Error
+    end.
+
+send(Socket, {Address, Port}, Data) -> send(Socket, Address, Port, Data);
+send(_Socket, _Destination, _Data) -> {error, enotsup}.
+
+send(Socket, {Address, Port}, [], Data) -> send(Socket, Address, Port, Data);
+send(Socket, Address, Port, Data) when is_integer(Port) ->
+    wasm_socket:call(Socket, {udp_send, Address, Port, Data});
+send(_Socket, _Destination, _Ancillary, _Data) -> {error, enotsup}.
+
+send(Socket, Address, Port, [], Data) -> send(Socket, Address, Port, Data);
+send(_Socket, _Address, _Port, _Ancillary, _Data) -> {error, enotsup}.
+
+recv(Socket, Length) -> recv(Socket, Length, infinity).
+recv(Socket, Length, Timeout) ->
+    wasm_socket:call(Socket, {udp_recv, Length, Timeout}).
+
+connect(Socket, Address, Port) ->
+    wasm_socket:call(Socket, {udp_connect, Address, Port}).
+
+controlling_process(Socket, Owner) ->
+    wasm_socket:call(Socket, {controlling_process, Owner}).
+setopts(Socket, Opts) -> wasm_socket:call(Socket, {setopts, Opts}).
+getopts(Socket, Names) -> wasm_socket:call(Socket, {getopts, Names}).
+sockname(Socket) -> wasm_socket:call(Socket, sockname).
+peername(Socket) -> wasm_socket:call(Socket, peername).
diff --git a/lib/kernel/src/wasm_virtual_network.erl b/lib/kernel/src/wasm_virtual_network.erl
new file mode 100644
index 0000000000000000000000000000000000000000..3aa7af0a9ce56c6d25581bc9c0b76d9c394e30b6
--- /dev/null
+++ b/lib/kernel/src/wasm_virtual_network.erl
@@ -0,0 +1,107 @@
+-module(wasm_virtual_network).
+-moduledoc false.
+
+-export([open_socket/1, close_socket/1, request/4, send/3]).
+
+-define(SERVER, wasm_virtual_network).
+
+open_socket(Pid) when is_pid(Pid) ->
+    call({open_socket, Pid}).
+
+close_socket(SocketId) when is_integer(SocketId) ->
+    call({close_socket, SocketId}).
+
+request(SocketId, Operation, Bytes, Timeout)
+  when is_integer(SocketId), is_map(Operation), is_binary(Bytes) ->
+    Ref = make_ref(),
+    server() ! {request, self(), Ref, SocketId, Operation, Bytes},
+    receive
+        {network_reply, Ref, Reply} -> Reply
+    after Timeout ->
+        {error, timeout}
+    end.
+
+send(SocketId, Operation, Bytes)
+  when is_integer(SocketId), is_map(Operation), is_binary(Bytes) ->
+    server() ! {send, SocketId, Operation, Bytes},
+    ok.
+
+call(Request) ->
+    Ref = make_ref(),
+    server() ! {call, self(), Ref, Request},
+    receive
+        {network_reply, Ref, Reply} -> Reply
+    end.
+
+server() ->
+    case whereis(?SERVER) of
+        undefined ->
+            Pid = spawn(fun init/0),
+            try register(?SERVER, Pid) of
+                true -> Pid
+            catch
+                error:badarg -> exit(Pid, kill), whereis(?SERVER)
+            end;
+        Pid -> Pid
+    end.
+
+init() ->
+    ok = wasm:network_register(),
+    loop(#{next_socket => 1, next_request => 1,
+           sockets => #{}, pending => #{}}).
+
+loop(State) ->
+    receive
+        {call, From, Ref, {open_socket, Pid}} ->
+            Id = maps:get(next_socket, State),
+            From ! {network_reply, Ref, {ok, Id}},
+            loop(State#{next_socket := Id + 1,
+                        sockets := maps:put(Id, Pid, maps:get(sockets, State))});
+        {call, From, Ref, {close_socket, Id}} ->
+            From ! {network_reply, Ref, ok},
+            loop(State#{sockets := maps:remove(Id, maps:get(sockets, State))});
+        {request, From, Ref, SocketId, Operation, Bytes} ->
+            RequestId = maps:get(next_request, State),
+            Command = envelope(SocketId, Operation#{requestId => RequestId}),
+            ok = wasm:network_send(json(Command), Bytes),
+            Pending = maps:put(RequestId, {From, Ref}, maps:get(pending, State)),
+            loop(State#{next_request := RequestId + 1, pending := Pending});
+        {send, SocketId, Operation, Bytes} ->
+            ok = wasm:network_send(json(envelope(SocketId, Operation)), Bytes),
+            loop(State);
+        {wasm_network, Metadata, Bytes} ->
+            Event = json:decode(Metadata),
+            loop(route(Event, Bytes, State))
+    end.
+
+route(#{<<"requestId">> := RequestId} = Event, _Bytes, State) ->
+    Pending = maps:get(pending, State),
+    case maps:take(RequestId, Pending) of
+        {{From, Ref}, Rest} ->
+            From ! {network_reply, Ref, reply(Event)},
+            State#{pending := Rest};
+        error -> State
+    end;
+route(#{<<"socketId">> := SocketId} = Event, Bytes, State) ->
+    case maps:find(SocketId, maps:get(sockets, State)) of
+        {ok, Pid} -> Pid ! {network_event, Event, Bytes};
+        error -> ok
+    end,
+    State.
+
+reply(#{<<"operation">> := <<"error">>, <<"reason">> := Reason}) ->
+    {error, reason(Reason)};
+reply(Event) ->
+    {ok, Event}.
+
+reason(<<"eaddrinuse">>) -> eaddrinuse;
+reason(<<"econnrefused">>) -> econnrefused;
+reason(<<"econnreset">>) -> econnreset;
+reason(<<"enobufs">>) -> enobufs;
+reason(<<"enoent">>) -> enoent.
+
+envelope(SocketId, Operation) ->
+    Operation#{version => 1, vmId => <<>>, socketId => SocketId}.
+
+json(Term) ->
+    iolist_to_binary(json:encode(Term)).
