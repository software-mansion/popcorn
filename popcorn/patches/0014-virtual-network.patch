+  js_bridge_on_virtual_network_async__proxy: 'async',
+  js_bridge_on_virtual_network_async__sig: 'viiii',
+  js_bridge_on_virtual_network_async: function(metadata, metadataLen, bytes, bytesLen) {
+    var metadataText;
+    var payload;
+    try {
+      metadataText = UTF8ToString(metadata, metadataLen);
+      payload = new Uint8Array(bytesLen);
+      payload.set(HEAPU8.subarray(bytes, bytes + bytesLen));
+    } finally {
+      _free(metadata);
+      _free(bytes);
+    }
+    if (typeof Module['onVirtualNetworkCommand'] === 'function') {
+      Module['onVirtualNetworkCommand'](metadataText, payload);
+    }
+  },
 });
