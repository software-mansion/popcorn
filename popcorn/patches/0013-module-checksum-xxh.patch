+-doc """
+Calculates the checksum used by the code loader for a module.
+""".
+-spec checksum(Beam) ->
+        {'ok', {module(), {'xxh3_128', binary()}}} |
+        {'error', 'beam_lib', chnk_rsn()} when
+      Beam :: beam().
+
+checksum(File0) ->
+    case catch checksum_1(File0) of
+	{ok, _} = Result ->
+	    Result;
+	Error ->
+	    Error
+    end.
+
+checksum_1(File0) ->
+    File = beam_filename(File0),
+    Beam = beam_data(File),
+    {ok, Module, _} = scan_beam(Beam, []),
+    case erts_internal:beamfile_module_checksum(Beam) of
+	Digest when is_binary(Digest) ->
+	    {ok, {Module, {xxh3_128, Digest}}};
+	undefined ->
+	    error({not_a_beam_file, File})
+    end.
+
